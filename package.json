{
  "name": "medallion-terminal-core",
  "version": "0.4.2",
  "type": "module",
  "main": "./dist/medallion-terminal-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/medallion-terminal-core.js",
      "types": "./dist/index.d.ts"
    },
    "./proto": {
      "types": "./dist/proto.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit && buf format --diff --exit-code && buf lint && buf build && pnpm gen:proto && git diff --exit-code src/gen",
    "gen:proto": "PATH=\"$PWD/node_modules/.bin:$PATH\" buf generate",
    "format": "buf format --write",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "prepare": "pnpm build:lib",
    "preview": "vite preview",
    "backend": "node examples/backend/server.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "ci": "pnpm install --frozen-lockfile && pnpm lint && pnpm test && pnpm build && pnpm build:lib && pnpm build:storybook"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "dompurify": "^3.4.7",
    "heic2any": "^0.0.4",
    "lightweight-charts": "^5.1.0",
    "marked": "^18.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@storybook/react": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.27.4",
    "storybook": "^10.2.19",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
