{
  "name": "medallion-terminal-core",
  "version": "0.4.20",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "main": "./dist/medallion-terminal-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/medallion-terminal-core.js",
      "default": "./dist/medallion-terminal-core.js"
    },
    "./proto": {
      "types": "./dist/proto.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit && buf format --diff --exit-code && buf lint && buf build && node scripts/check-generated.mjs",
    "gen:proto": "PATH=\"$PWD/node_modules/.bin:$PATH\" buf generate",
    "format": "buf format --write",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "prepack": "pnpm build:lib",
    "preview": "vite preview",
    "check:dist": "node scripts/check-dist.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm build:lib && pnpm check:package",
    "backend": "node examples/backend/server.mjs",
    "storybook": "storybook dev -p 6006",
    "check:storybook": "node scripts/check-storybook.mjs",
    "build:storybook": "storybook build && pnpm check:storybook",
    "ci": "pnpm install --frozen-lockfile && pnpm lint && pnpm test && pnpm build && pnpm check:dist && pnpm check:package && pnpm build:storybook"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "dompurify": "^3.4.12",
    "heic2any": "^0.0.4",
    "hyparquet-writer": "^0.16.1",
    "lightweight-charts": "^5.2.0",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@storybook/react": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "hyparquet": "^1.26.2",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
