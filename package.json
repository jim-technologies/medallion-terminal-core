{
  "name": "medallion-terminal-core",
  "version": "0.8.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "main": "./dist/medallion-terminal-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/medallion-terminal-core.js",
      "default": "./dist/medallion-terminal-core.js"
    },
    "./toolkit": {
      "types": "./dist/toolkit.d.ts",
      "import": "./dist/toolkit.js",
      "default": "./dist/toolkit.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js",
      "default": "./dist/dashboard.js"
    },
    "./asset-open": {
      "types": "./dist/asset-open.d.ts",
      "import": "./dist/asset-open.js",
      "default": "./dist/asset-open.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./messages-zh": {
      "types": "./dist/messages-zh.d.ts",
      "import": "./dist/messages-zh.js",
      "default": "./dist/messages-zh.js"
    },
    "./proto": {
      "types": "./dist/proto.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit && node scripts/check-style-tokens.mjs && buf format --diff --exit-code && buf lint && buf build && node scripts/check-generated.mjs",
    "gen:proto": "PATH=\"$PWD/node_modules/.bin:$PATH\" buf generate",
    "format": "buf format --write",
    "test": "vitest run --project=unit",
    "test:storybook": "STORYBOOK_PERFORMANCE_PHASE=0 vitest run --project=storybook",
    "test:browser": "STORYBOOK_PERFORMANCE_PHASE=0 PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/behavior playwright test --grep-invert @performance --output test-results/behavior && STORYBOOK_PERFORMANCE_PHASE=1 PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/performance playwright test --grep @performance --workers 1 --retries 0 --output test-results/performance",
    "bench": "vitest bench --run",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "check:dist": "node scripts/check-dist.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:bundles": "node scripts/check-bundle-isolation.mjs",
    "check:breaking": "node scripts/check-breaking.mjs",
    "check:surface": "scripts/public-surface-check && scripts/public-surface-check-test",
    "check:version": "node scripts/check-version.mjs",
    "backend": "node examples/backend/server.mjs",
    "backend:secure": "node examples/backend/secure-server.mjs",
    "storybook": "storybook dev -p 6006",
    "check:storybook": "node scripts/check-storybook.mjs",
    "check:conformance": "node scripts/check-reference-conformance.mjs",
    "build:storybook": "STORYBOOK_PERFORMANCE_PHASE=0 storybook build && pnpm check:storybook",
    "validate": "pnpm check:surface && pnpm check:version && pnpm lint && pnpm check:breaking && pnpm check:conformance && pnpm test && pnpm test:storybook && pnpm build && pnpm check:dist && pnpm check:package && pnpm check:bundles && pnpm build:storybook && pnpm test:browser"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0",
    "maplibre-gl": "^5.0.0 || ^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "hyparquet-writer": "^0.17.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "esbuild": "^0.28.2",
    "hyparquet": "^1.31.5",
    "lightweight-charts": "^5.2.1",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
