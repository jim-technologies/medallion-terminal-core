# esbuild ships its native binary via an optional platform package, so the
# library builds fine even when esbuild's postinstall is skipped. pnpm 11 turns
# any skipped build into a FATAL error by default (strict-dep-builds), which
# breaks `prepare` when this package is consumed as a git dependency. Downgrade
# that to a warning; the allowlist in pnpm-workspace.yaml still builds esbuild
# when the environment permits.
strict-dep-builds=false
