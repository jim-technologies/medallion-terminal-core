{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/__tests__/**",
    "src/main.tsx",
    "src/embed/main.tsx",
    "src/App.tsx",
    "src/ExamplesIndex.tsx"
  ]
}
