      "id": "header",
      "component": "stat_strip",
      "span": 12,
      "height": 90,
      "source": {
        "inline": [
          { "label": "Workflows",   "value":  142 },
          { "label": "Running",     "value":   18, "delta":  0.06 },
          { "label": "Completed 24h","value": 4280, "trend": [3800, 3900, 4020, 4100, 4180, 4220, 4280] },
          { "label": "Failed 24h",  "value":   42, "delta": -0.18 },
          { "label": "Avg Duration","value":   84, "unit": "s", "delta": 0.04 },
          { "label": "p95 Duration","value":  324, "unit": "s", "delta": 0.12 }
        ]
      }
    },

    {
      "id": "alerts",
      "component": "ticker",
      "span": 12,
      "height": 56,
      "source": {
        "inline": {
          "events": [
            { "timestamp": "14:51", "label": "Workflow `ingest_market_data` failed (3rd retry)", "status": "EVENT_STATUS_ERROR" },
