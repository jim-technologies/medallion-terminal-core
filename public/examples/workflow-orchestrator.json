        "row_context": { "key": "workflow_id", "field": "Workflow" },
        "heat_columns": ["Elapsed (s)", "Retries"]
      },
      "source": {
        "inline": [
          { "Workflow": "ingest_market_data",   "Run ID": "wf-8a4f", "Started": "14:48:02", "Elapsed (s)":  186, "Status": "Running",    "Retries": 0, "Worker": "ingest-3" },
          { "Workflow": "compute_features",     "Run ID": "wf-7c91", "Started": "14:42:14", "Elapsed (s)":  548, "Status": "Running",    "Retries": 0, "Worker": "compute-1" },
          { "Workflow": "backtest_strategy_v3", "Run ID": "wf-6e22", "Started": "14:31:48", "Elapsed (s)": 1174, "Status": "Running",    "Retries": 1, "Worker": "compute-4" },
