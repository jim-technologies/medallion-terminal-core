        "inline": [
          { "label": "Uptime",     "value": 99.94, "unit": "%" },
          { "label": "RPS (1m)",   "value":  4280, "delta":  0.018, "trend": [3900, 3950, 4020, 4150, 4180, 4220, 4280] },
          { "label": "p50",        "value":  18.4, "unit": "ms",     "delta": -0.024 },
