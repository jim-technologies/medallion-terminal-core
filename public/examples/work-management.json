      "ctx": {
        "record_id": "work-101"
      }
    }
  ],
  "widgets": [
    {
      "id": "records-grid",
      "component": "record_grid",
      "span": 12,
      "height": 430,
      "title": "Work items",
      "options": {
        "view_id": "all_work",
        "page_size": 12,
        "page_token_key": "records_page_token",
        "search": true,
        "inline_edit": true
      },
      "source": {
        "source_id": "business_records",
        "params": {
          "table_id": "${ctx.table_id}",
          "page_token": "${ctx.records_page_token}",
