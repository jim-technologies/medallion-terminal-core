{
  "title": "Work management · ${ctx.table_id}",
  "columns": 12,
  "context": {
    "values": {
      "table_id": "work_items",
      "record_id": "work-101",
      "records_page_token": ""
    }
  },
  "shortcuts": [
    {
      "key": "n",
      "label": "New record",
