{
  "title": "File browser — ${ctx.namespace}",
  "context": {
    "values": {
      "namespace": "demo",
      "path": "",
      "page": "1",
      "page_size": "50",
      "view_mode": "icons"
    }
  },
  "widgets": [
    {
      "id": "ns",
      "component": "metric",
      "span": 3,
      "height": 100,
      "title": "Namespace",
      "source": { "inline": { "value": 0, "label": "${ctx.namespace}" } }
    },

    {
      "id": "tip",
      "component": "text",
      "span": 9,
      "height": 100,
      "title": "Demo",
      "source": {
        "inline": {
          "items": [
            { "body": "Open a folder and drag files into it, or use Upload to choose a destination folder. Drop a video and scrub the preview — the /media endpoint supports Range requests so seek works without re-downloading." }
          ]
        }
      }
    },

    {
      "id": "browser",
      "component": "file_browser",
      "span": 12,
      "height": 540,
      "title": "Files at /${ctx.path}",
      "refresh_policy": "self",
      "options": {
        "path_ctx": "path",
        "bucket_ctx": "namespace",
        "bucket_param": "namespace",
        "page_ctx": "page",
        "page_size_ctx": "page_size",
        "view_mode_ctx": "view_mode",
        "upload_action_id": "upload",
        "download_url": "/files.v1.FileService/Download",
        "media_url_template": "/media?namespace={namespace}&path={path}"
      },
      "source": {
        "source_id": "files",
        "params": {
          "namespace": "${ctx.namespace}",
          "path": "${ctx.path}",
          "page": "${ctx.page}",
          "page_size": "${ctx.page_size}"
        }
      }
    },

    {
      "id": "log",
      "component": "action_log",
      "span": 12,
      "height": 200,
      "title": "Upload log"
    }
  ]
}
